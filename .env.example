# Copia este archivo a .env y rellena tu clave:  cp .env.example .env
# El .env está excluido de git (.gitignore) y del build de Docker (.dockerignore).

# Obligatoria. Clave de la API de Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui

# Opcional. Modelo de Groq (por defecto: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
