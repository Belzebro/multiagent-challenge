# Copia este archivo a .env y rellena tu clave:  cp .env.example .env
# El .env está excluido de git (.gitignore) y del build de Docker (.dockerignore).

# Obligatoria. Clave de la API de Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui

# Opcional. Modelo de Groq (por defecto: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Secreto para firmar y verificar los JWT (mínimo 32 caracteres). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Opcionales (iteración 2) ---------------------------------------------------------------------
# Límite de turnos de /chat por usuario y minuto (0 lo desactiva). Se cuenta en la base de datos.
# RATE_LIMIT_PER_MINUTE=20

# OIDC: verifica los tokens con RS256 y las claves públicas del proveedor en lugar de HS256.
# JWT_JWKS_URL=https://tu-proveedor/.well-known/jwks.json
# JWT_ISSUER=https://tu-proveedor/
# JWT_AUDIENCE=getnet-multiagent-api

# Estado compartido entre réplicas (memoria, tickets, feedback y límites) en Postgres.
# Con el perfil `postgres` de compose:
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://getnet:<POSTGRES_PASSWORD>@postgres:5432/getnet

# Observabilidad: trazas a Jaeger (perfil `observability`) y token para /metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# METRICS_TOKEN=

# Circuit breaker del LLM: fallos seguidos para abrirlo y segundos que permanece abierto.
# CIRCUIT_FAILURES=3
# CIRCUIT_COOLDOWN_S=30

# Solo para las evaluaciones (evals/judge.py); la API no la usa.
# ANTHROPIC_API_KEY=
